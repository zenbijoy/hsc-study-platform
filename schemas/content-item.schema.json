{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hsc.local/schemas/content-item.schema.json",
  "title": "HSC Universal Content Item",
  "type": "object",
  "required": ["type", "subject", "chapter"],
  "properties": {
    "type": { "enum": ["formula", "cq", "mcq", "note", "definition", "flashcard", "unknown"] },
    "subject": { "type": "string", "minLength": 1 },
    "paper": { "type": ["integer", "null"], "minimum": 1, "maximum": 2 },
    "chapter": { "type": "string", "minLength": 1 },
    "title": { "type": ["string", "null"] },
    "latex": { "type": ["string", "null"] },
    "question": { "type": ["string", "null"] },
    "answer": { "type": ["string", "null"] },
    "options": { "type": ["array", "null"], "items": { "type": "string" } },
    "board": { "type": ["string", "null"] },
    "year": { "type": ["integer", "null"], "minimum": 1900, "maximum": 2200 },
    "difficulty": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
    "importance": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "source": { "type": ["string", "null"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "extra": { "type": "object" }
  },
  "additionalProperties": true,
  "allOf": [
    { "if": { "properties": { "type": { "const": "formula" } } }, "then": { "required": ["latex"] } },
    { "if": { "properties": { "type": { "enum": ["cq", "mcq"] } } }, "then": { "required": ["question"] } }
  ]
}
