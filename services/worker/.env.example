# Local zero-cost mode works without cloud credentials.
STORAGE_PROVIDER=local
WAREHOUSE_DIR=./var/warehouse
INBOX_DIR=./var/inbox
JOB_DB=./var/jobs.sqlite3
CATALOG_FILE=./var/catalog.json
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Drive origin (for personal 5 TB account use OAuth refresh-token mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_PUBLIC_PACKAGES=false

# Optional service account mode (typically Workspace / shared-drive scenarios)
GOOGLE_APPLICATION_CREDENTIALS=

# Optional Cloudflare R2 provider (set STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Example: https://cdn.example.com  (leave blank for private-only objects)
R2_PUBLIC_BASE_URL=

# Supabase server-side only
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes, base64. Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
CONTENT_MASTER_KEY_B64=
CONTENT_MASTER_KEY_VERSION=1

# Processing
DEFAULT_CHUNK_SIZE=4194304
MAX_UPLOAD_BYTES=2147483648
DEEP_PDF_PAGE_LIMIT=1200
WORKER_CONCURRENCY=2
