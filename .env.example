# ==============================================================================
# HSC STUDY PLATFORM — ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==============================================================================
# Copy to appropriate sub-project locations:
#   - apps/admin/.env.local
#   - apps/mobile/.env
#   - services/worker/.env
#
# NEVER commit real secret values, master keys, or service role credentials.
# ==============================================================================

# --- SUPABASE (Database, Auth, Storage Metadata) ---
# PUBLIC (Client Safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...
EXPO_PUBLIC_LICENSE_FUNCTION_URL=https://your-project.supabase.co/functions/v1/book-license

# SERVER-ONLY (Worker & Edge Functions — Keep Secret)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- HSCP ENCRYPTION MASTER KEY ---
# SERVER-ONLY: 32 random bytes, base64 encoded
# Generate with: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
CONTENT_MASTER_KEY_B64=
CONTENT_MASTER_KEY_VERSION=1

# --- CONTENT FACTORY WORKER & CMS ---
NEXT_PUBLIC_INGEST_API_URL=http://localhost:8787
STORAGE_PROVIDER=local
WAREHOUSE_DIR=./var/warehouse
INBOX_DIR=./var/inbox
JOB_DB=./var/jobs.sqlite3
CATALOG_FILE=./var/catalog.json
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WORKER_CONCURRENCY=2
MAX_UPLOAD_BYTES=2147483648

# --- GOOGLE DRIVE ORIGIN WAREHOUSE (Private 5TB) ---
# SERVER-ONLY (OAuth refresh-token mode or Service Account)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_PUBLIC_PACKAGES=false
GOOGLE_APPLICATION_CREDENTIALS=

# --- CLOUDFLARE R2 (Optional Hot Cache) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
